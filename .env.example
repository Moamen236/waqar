APP_NAME=WAQAR
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:26991

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Matches docker-compose.yml's mysql service — same values as its
# MYSQL_DATABASE/MYSQL_USER/MYSQL_PASSWORD defaults.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=waqar
DB_USERNAME=waqar
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# Matches docker-compose.yml's redis service. ext-redis (phpredis) is
# compiled into docker/Dockerfile, so no predis/predis composer package
# is needed (Section 23).
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# SMTP against the business's own mail server — no third-party
# transactional API (Section 23's "explicitly NOT needed" list rules out
# SendGrid/Mailgun/SES-style services alongside the payment, social-login
# and SMS SDKs).
#
# Locally these point at the `mailpit` service, which speaks real SMTP and
# collects everything at http://localhost:32232 — so the SMTP transport is
# exercised in development rather than first meeting production.
# Production changes only these values, never application code:
#   MAIL_HOST=mail.yourdomain.com
#   MAIL_PORT=587
#   MAIL_SCHEME=tls          (or `smtps` on port 465)
#   MAIL_USERNAME / MAIL_PASSWORD from the business's mailbox
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
# Laravel's scaffold default — replace with the business's own
# sending address before launch (the cutover checklist checks this).
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_SUPPORT_ADDRESS="support@waqar.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
